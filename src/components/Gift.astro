---
import { invite } from '../config.js';
---
<section>
  <h2>Wedding Gift</h2>
  <p class="small">Your blessings are the greatest gift to us. If you wish to express your gratitude with a gift, you may do so through the information below.</p>
  {invite.accounts.map((a) => (
    <div class="acct">
      <div><b>{a.bank} · {a.number}</b><span class="small">Account holder: {a.name}</span></div>
      <button class="btn" data-copy={a.number}>Copy</button>
    </div>
  ))}
</section>

<script>
  const toast = (t) => {
    const e = document.getElementById('toast');
    e.textContent = t;
    e.classList.add('show');
    setTimeout(() => e.classList.remove('show'), 1800);
  };
  document.querySelectorAll('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy); toast('Number copied'); }
      catch { toast('Copy failed, please copy manually'); }
    })
  );
</script>
