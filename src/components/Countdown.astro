---
import { invite } from '../config.js';
---
<section>
  <h2>Hitung mundur</h2>
  <div class="count" id="count" data-target={invite.dateISO}>
    <div><b id="d">0</b><span>Hari</span></div>
    <div><b id="h">0</b><span>Jam</span></div>
    <div><b id="m">0</b><span>Menit</span></div>
    <div><b id="s">0</b><span>Detik</span></div>
  </div>
  <button class="btn" id="icsBtn" style="margin-top:20px" data-title={`Pernikahan ${invite.short}`} data-loc={invite.events[0].place}>Simpan ke kalender</button>
</section>

<script>
  const target = new Date(document.getElementById('count').dataset.target).getTime();
  const set = (id, v) => (document.getElementById(id).textContent = v);
  function tick() {
    const t = Math.max(0, target - Date.now());
    set('d', Math.floor(t / 864e5));
    set('h', Math.floor((t % 864e5) / 36e5));
    set('m', Math.floor((t % 36e5) / 6e4));
    set('s', Math.floor((t % 6e4) / 1e3));
  }
  tick();
  setInterval(tick, 1000);

  const fmt = (ms) => new Date(ms).toISOString().replace(/[-:]|\.\d{3}/g, '');
  document.getElementById('icsBtn').addEventListener('click', (e) => {
    const b = e.currentTarget;
    const ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'BEGIN:VEVENT',
      'DTSTART:' + fmt(target), 'DTEND:' + fmt(target + 6 * 36e5),
      'SUMMARY:' + b.dataset.title, 'LOCATION:' + b.dataset.loc,
      'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
    a.download = 'undangan.ics';
    a.click();
  });
</script>
